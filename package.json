{
  "name": "dsh-wsl-git",
  "version": "0.15.0-wsl",
  "description": "Fork patch of dsh-ide-git 0.13.5 (MIT): the same IDE-grade Git tool window, but git runs INSIDE the WSL distribution the session workspace belongs to. A WSL workspace path names its own distribution, so nothing is hard-coded and one install serves every distribution; a workspace that is not a WSL workspace behaves exactly as the baseline. Launcher failures are named instead of being served as \"not a git repository\". | dsh-ide-git 0.13.5 的 fork 补丁:同一个 IDE 级 Git 工具窗口,但 git 在会话工作区所属的 WSL 发行版内执行。发行版由工作区路径决定,无需配置;非 WSL 工作区行为与基线完全一致。启动器失败会被点名,不再伪装成「不是 git 仓库」。",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SteafShi/dsh-wsl-git.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.6-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "files": [
    "icon.svg",
    "locale",
    "src",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.upstream.md",
    "README.upstream.en.md",
    "FORK.md",
    "CHANGELOG.md",
    "PUBLISHING.md",
    "NOTICE",
    "patch",
    "docs/screenshots",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/target.test.mjs",
    "version": "node -e \"const fs=require('fs');const m=JSON.parse(fs.readFileSync('dsh.plugin.json','utf8'));const v=JSON.parse(fs.readFileSync('package.json','utf8')).version;m.version=v;fs.writeFileSync('dsh.plugin.json',JSON.stringify(m,null,2)+'\\n')\" && git add dsh.plugin.json",
    "probe:settings-card": "node scripts/settings-card-probe.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-better-sidebar",
    "git",
    "git-gui",
    "source-control",
    "sidebar",
    "commit-graph",
    "wsl",
    "wsl2",
    "fork",
    "dsh-ide-git"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.1.6-alpha.2",
    "dsh-better-sidebar": ">=0.12.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "homepage": "https://github.com/SteafShi/dsh-wsl-git#readme",
  "bugs": {
    "url": "https://github.com/SteafShi/dsh-wsl-git/issues"
  },
  "icon": "./icon.svg"
}
